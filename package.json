{
  "name": "auto-parts-store",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "docker compose up --build",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:lint": "pnpm --dir frontend lint",
    "frontend:preview": "pnpm --dir frontend preview",
    "backend:serve": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "backend:test": "php backend/artisan test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "packageManager": "pnpm@11.1.3"
}
